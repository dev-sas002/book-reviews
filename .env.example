# Variables the production image reads. Docker Compose sets its own values, and
# development and test need none of these. To run the image on its own:
#   cp .env.example .env && docker run --env-file .env -p 3000:3000 <image>
DATABASE_URL=postgres://he_better_reads:change-me@localhost:5432/he_better_reads_production
# Generate with `bin/rails secret`. Left empty, the entrypoint makes a throwaway one.
SECRET_KEY_BASE=
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
PORT=3000
